# Entity: gpn

main: kit: entity: gpn: {

  alias: field: {}

  fields: [
    {
      name: "ARG_OF_PERICENTER"
      req: false
      short: "Argument of perigee in degrees"
      type: "`$NUMBER`"
    }
    {
      name: "BSTAR"
      req: false
      short: "BSTAR drag term"
      type: "`$NUMBER`"
    }
    {
      name: "CLASSIFICATION_TYPE"
      req: false
