      req: false
      short: "Orbital eccentricity"
      type: "`$NUMBER`"
    }
    {
      name: "ELEMENT_SET_NO"
      req: false
      short: "Element set number"
      type: "`$INTEGER`"
    }
    {
      name: "EPHEMERIS_TYPE"
      req: false
      short: "Ephemeris type"
      type: "`$INTEGER`"
    }
    {
