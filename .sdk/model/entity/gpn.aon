      req: false
      short: "Epoch time of the orbital elements"
      type: "`$STRING`"
    }
    {
      name: "INCLINATION"
      req: false
      short: "Inclination in degrees"
      type: "`$NUMBER`"
    }
    {
      name: "MEAN_ANOMALY"
      req: false
      short: "Mean anomaly in degrees"
      type: "`$NUMBER`"
    }
    {
      name: "MEAN_MOTION"
