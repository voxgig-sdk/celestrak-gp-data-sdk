                orig: "name"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/NORAD/elements/gp.php"
          parts: [
            "NORAD"
            "elements"
            "gp.php"
          ]
          select: {
            exist: [
              "catnr"
              "format"
              "group"
              "intde"
              "name"
            ]
          }
          transform: {
            req: "`reqdata`"
