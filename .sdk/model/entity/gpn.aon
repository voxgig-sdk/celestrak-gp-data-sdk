      type: "`$NUMBER`"
    }
    {
      name: "MEAN_MOTION_DOT"
      req: false
      short: "First derivative of mean motion"
      type: "`$NUMBER`"
    }
    {
      name: "NORAD_CAT_ID"
      req: false
      short: "NORAD catalog number"
      type: "`$INTEGER`"
    }
    {
      name: "OBJECT_ID"
      req: false
      short: "International designator"
      type: "`$STRING`"
    }
    {
      name: "OBJECT_NAME"
      req: false
      short: "Name of the space object"
